      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 839827600,
      "version": 2,
      "versionNonce": 1817779824,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794136644674,
      "link": null,
      "locked": false,
      "customData": null,
      "text": "• muitas operações pequenas, cada uma por chave\n• a linha inteira, poucas linhas por vez\n• lê e escreve o tempo todo\n• resposta em milissegundos\n• transação: tudo ou nada (ACID)",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• muitas operações pequenas, cada uma por chave\n• a linha inteira, poucas linhas por vez\n• lê e escreve o tempo todo\n• resposta em milissegundos\n• transação: tudo ou nada (ACID)",
      "autoResize": true,
      "lineHeight": 1.25
    },
