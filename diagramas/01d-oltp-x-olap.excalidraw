    {
      "id": "t-64",
      "type": "text",
      "x": 40,
      "y": 430,
      "width": 410.0730895996094,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
